# Ambiente local do ServiumAI — copie para .env (ignorado pelo git)
# Nenhum secret real aqui: valores padrão são apenas para desenvolvimento local.

POSTGRES_USER=servium
POSTGRES_PASSWORD=servium_dev
POSTGRES_DB=servium
POSTGRES_PORT=5432

DATABASE_URL=postgres://servium:servium_dev@localhost:5432/servium

# B-2 · canal de comunicação (none | mailpit | gmail) — default dev/CI: mailpit
COMMUNICATION_ADAPTER=mailpit
MAILPIT_API_URL=http://localhost:8025
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_FROM=assistente@servium.local
MAILPIT_AGENT_EMAIL=assistente@servium.local

# B-2 · cadência do scheduler de recebimento (ms) — legado E2E:
# RECEBER_INTERVAL_MS continua sendo a cadência canônica de leitura
RECEBER_INTERVAL_MS=30000
RECEIVER_WINDOW_MS=30000

# B-2 · Gmail (HG-007 · AWAITING_DECISION) — SEM valores reais neste arquivo.
# Preencher apenas em ambiente protegido DAIL+; nunca commitar secret.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REDIRECT_URI=
# Identity para envio via Gmail é a conta OAuth ("me") — não há "from" configurável.

# Rate limit do login — defaults da política estão em docs/security/RATE_LIMIT_POLICY.md.
# Em DEV local, folgas maiores evitam bloqueios durante o desenvolvimento:
# LOGIN_RATE_LIMIT_ACCOUNT_MAX=50
# LOGIN_RATE_LIMIT_ACCOUNT_WINDOW_MS=900000
# LOGIN_RATE_LIMIT_IP_MAX=300
# LOGIN_RATE_LIMIT_IP_WINDOW_MS=300000

# Origens permitidas pelo CORS (dev local) — separadas por vírgula.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
